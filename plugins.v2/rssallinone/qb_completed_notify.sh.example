#!/bin/sh
# Universal qBittorrent "Run external program on torrent finished" command:
# /bin/sh /config/qb_completed_notify.sh "<node>" "<node_url>" "%I" "%L" "%N" "%G"
# Arguments: 1=node 2=node_url 3=hash 4=category 5=name 6=tags
# Legacy 4-argument mode remains compatible and defaults to QBSSD/8081.

set -u

LOG_FILE="/config/qb_notify.log"
V1_CALLBACK_URL="http://192.168.110.31:18501/api/qb/callback/completed"
V1_SECRET="CHANGE_ME"
DEFAULT_NODE="QBSSD"
DEFAULT_NODE_URL="http://192.168.110.31:8081"

MP_BASE_URL="http://192.168.110.31:3033"
MP_API_TOKEN="CHANGE_ME"
PLUGIN_CALLBACK_URL="${MP_BASE_URL}/api/v1/plugin/RssAllInOne/qb/completed"
MP_TRANSFER_URL="${MP_BASE_URL}/api/v1/transfer/now?token=${MP_API_TOKEN}"

log() {
  printf '%s [qb_notify] %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"
}

if [ "$#" -ge 6 ]; then
  NODE_NAME="${1:-}"
  NODE_URL="${2:-}"
  HASH="${3:-}"
  CATEGORY="${4:-}"
  NAME="${5:-}"
  TAGS="${6:-}"
else
  NODE_NAME="$DEFAULT_NODE"
  NODE_URL="$DEFAULT_NODE_URL"
  HASH="${1:-}"
  CATEGORY="${2:-}"
  NAME="${3:-}"
  TAGS="${4:-}"
fi

if [ -z "$NODE_NAME" ] || [ -z "$NODE_URL" ] || [ -z "$HASH" ]; then
  log "ERROR missing node, node_url, or hash"
  exit 2
fi

if [ "$V1_SECRET" = "CHANGE_ME" ] || [ "$MP_API_TOKEN" = "CHANGE_ME" ]; then
  log "ERROR configure V1_SECRET and MP_API_TOKEN first"
  exit 2
fi

if [ -x /usr/bin/curl ]; then
  CURL_BIN="/usr/bin/curl"
else
  CURL_BIN="curl"
fi

log "START node=$NODE_NAME node_url=$NODE_URL hash=$HASH category=$CATEGORY name=$NAME tags=$TAGS"

V1_OK=0
if V1_RESPONSE="$("$CURL_BIN" -fsS --retry 3 --retry-delay 3 --retry-connrefused -G \
  "$V1_CALLBACK_URL" \
  --data-urlencode "node=$NODE_NAME" \
  --data-urlencode "node_url=$NODE_URL" \
  --data-urlencode "hash=$HASH" \
  --data-urlencode "category=$CATEGORY" \
  --data-urlencode "name=$NAME" \
  --data-urlencode "secret=$V1_SECRET" 2>&1)"
then
  V1_OK=1
  log "V1_CALLBACK ok response=$V1_RESPONSE"
else
  V1_RC=$?
  log "V1_CALLBACK fail rc=$V1_RC response=$V1_RESPONSE"
fi

# Give qB a moment to persist its final state before the plugin reads the torrent.
sleep 2

PLUGIN_OK=0
PLUGIN_PAYLOAD="$(printf '{"info_hash":"%s","downloader_id":"%s"}' "$HASH" "$NODE_NAME")"
PLUGIN_RESPONSE="$("$CURL_BIN" -fsS --retry 3 --retry-delay 3 --retry-connrefused \
  -X POST "$PLUGIN_CALLBACK_URL" \
  -H "X-API-KEY: $MP_API_TOKEN" \
  -H "Content-Type: application/json" \
  --data "$PLUGIN_PAYLOAD" 2>&1)"
PLUGIN_RC=$?

if [ "$PLUGIN_RC" -eq 0 ] && printf '%s' "$PLUGIN_RESPONSE" \
  | grep -Eq '"success"[[:space:]]*:[[:space:]]*true'
then
  PLUGIN_OK=1
  log "RSSALLINONE_CALLBACK ok response=$PLUGIN_RESPONSE"
else
  log "RSSALLINONE_CALLBACK fail rc=$PLUGIN_RC response=$PLUGIN_RESPONSE"
fi

MP_TRANSFER_OK=1
TAGS_CLEAN="$(printf '%s' "$TAGS" | tr -d ' ')"
case ",$TAGS_CLEAN," in
  *,MOVIEPILOT,*)
    MP_TRANSFER_OK=0
    if MP_TRANSFER_RESPONSE="$("$CURL_BIN" -fsS --retry 3 --retry-delay 3 \
      --retry-connrefused "$MP_TRANSFER_URL" 2>&1)"
    then
      MP_TRANSFER_OK=1
      log "MOVIEPILOT_TRANSFER_CALLBACK ok response=$MP_TRANSFER_RESPONSE"
    else
      MP_TRANSFER_RC=$?
      log "MOVIEPILOT_TRANSFER_CALLBACK fail rc=$MP_TRANSFER_RC response=$MP_TRANSFER_RESPONSE"
    fi
    ;;
  *)
    log "MOVIEPILOT_TRANSFER_CALLBACK skipped tag_not_matched"
    ;;
esac

if [ "$V1_OK" -eq 1 ] && [ "$PLUGIN_OK" -eq 1 ] && [ "$MP_TRANSFER_OK" -eq 1 ]; then
  log "DONE"
  exit 0
fi

log "DONE_WITH_ERRORS v1_ok=$V1_OK rssallinone_ok=$PLUGIN_OK moviepilot_transfer_ok=$MP_TRANSFER_OK"
exit 1
